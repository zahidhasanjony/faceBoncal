{
  "name": "edutalk-bone-remodeling-remotion",
  "version": "1.1.0",
  "private": true,
  "description": "EduTalk bone remodeling: Warm Cream, 60fps, 47 synchronized SRT cues, 26 scenes",
  "scripts": {
    "fonts": "node scripts/fetch_fonts.mjs",
    "timeline": "python3 scripts/build_timeline.py",
    "studio": "remotion studio src/index.ts --no-open",
    "compositions": "remotion compositions src/index.ts",
    "typecheck": "tsc --noEmit",
    "still:hook": "remotion still src/index.ts Main out/stills/hook.png --frame=96 --overwrite",
    "still:food": "remotion still src/index.ts Main out/stills/food.png --frame=7000 --overwrite",
    "render": "remotion render src/index.ts Main dist/EduTalk_BoneHealth_1080x1920.mp4 --codec=h264 --crf=18 --concurrency=2 --overwrite"
  },
  "dependencies": {
    "@remotion/fonts": "4.0.539",
    "@remotion/cli": "4.0.539",
    "remotion": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "typescript": "5.9.3"
  }
}
