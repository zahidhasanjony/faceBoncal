[
  {
    "id": 1,
    "startMs": 50,
    "endMs": 4223,
    "startFrame": 3,
    "endFrame": 253,
    "text": "আপনি কি ভাবছেন, শরীরে শুধু ক্যালসিয়ামের অভাবেই হাড় ক্ষয় হয়?"
  },
  {
    "id": 2,
    "startMs": 4293,
    "endMs": 5645,
    "startFrame": 258,
    "endFrame": 339,
    "text": "একদম ভুল!"
  },
  {
    "id": 3,
    "startMs": 5715,
    "endMs": 9141,
    "startFrame": 343,
    "endFrame": 548,
    "text": "আপনি যদি প্রতিদিন মুঠো মুঠো ক্যালসিয়াম ট্যাবলেটও খান,"
  },
  {
    "id": 4,
    "startMs": 9211,
    "endMs": 13343,
    "startFrame": 553,
    "endFrame": 801,
    "text": "তবুও আপনার হাড় ভেতর থেকে ঘুণে ধরা কাঠের মতো ঝাঁঝরা হয়ে যেতে পারে।"
  },
  {
    "id": 5,
    "startMs": 13413,
    "endMs": 14367,
    "startFrame": 805,
    "endFrame": 862,
    "text": "কিন্তু কেন?"
  },
  {
    "id": 6,
    "startMs": 14437,
    "endMs": 17410,
    "startFrame": 866,
    "endFrame": 1045,
    "text": "কারণ আসল সমস্যা ক্যালসিয়ামে নয়।"
  },
  {
    "id": 7,
    "startMs": 17480,
    "endMs": 21563,
    "startFrame": 1049,
    "endFrame": 1294,
    "text": "সমস্যা আপনার হাড়ের ভেতরে থাকা দুই দল মিস্ত্রির গোপন যুদ্ধে!"
  },
  {
    "id": 8,
    "startMs": 21633,
    "endMs": 24045,
    "startFrame": 1298,
    "endFrame": 1443,
    "text": "আমাদের হাড় কোনো শুকনো মরা কাঠ নয়।"
  },
  {
    "id": 9,
    "startMs": 24115,
    "endMs": 28226,
    "startFrame": 1447,
    "endFrame": 1694,
    "text": "এটি চব্বিশ ঘণ্টা চলতে থাকা একটি কনস্ট্রাকশন সাইট।"
  },
  {
    "id": 10,
    "startMs": 28296,
    "endMs": 32896,
    "startFrame": 1698,
    "endFrame": 1974,
    "text": "এর ভেতরে ভাঙচুর দল প্রতিদিন পুরোনো, ফাটল ধরা হাড় ভেঙে পরিষ্কার করে।"
  },
  {
    "id": 11,
    "startMs": 32966,
    "endMs": 37018,
    "startFrame": 1978,
    "endFrame": 2221,
    "text": "আর সাথে সাথেই রাজমিস্ত্রি দল সেখানে নতুন ক্যালসিয়ামের সিমেন্ট বসিয়ে"
  },
  {
    "id": 12,
    "startMs": 37088,
    "endMs": 39681,
    "startFrame": 2225,
    "endFrame": 2381,
    "text": "হাড়কে নতুনের মতো মজবুত করে তোলে।"
  },
  {
    "id": 13,
    "startMs": 39751,
    "endMs": 42447,
    "startFrame": 2385,
    "endFrame": 2547,
    "text": "ত্রিশ বছর বয়স পর্যন্ত এই রাজমিস্ত্রিরা"
  },
  {
    "id": 14,
    "startMs": 42517,
    "endMs": 46141,
    "startFrame": 2551,
    "endFrame": 2768,
    "text": "ভাঙচুর দলের চেয়ে অনেক বেশি গতিতে কাজ করে।"
  },
  {
    "id": 15,
    "startMs": 46211,
    "endMs": 47139,
    "startFrame": 2773,
    "endFrame": 2828,
    "text": "কিন্তু বয়স ত্রিশ পেরোলে,"
  },
  {
    "id": 16,
    "startMs": 47139,
    "endMs": 50754,
    "startFrame": 2828,
    "endFrame": 3045,
    "text": "আমাদেরই এক নীরব ভুলে এই রাজমিস্ত্রিরা ঘুমিয়ে পড়ে!"
  },
  {
    "id": 17,
    "startMs": 50824,
    "endMs": 52944,
    "startFrame": 3049,
    "endFrame": 3177,
    "text": "আমাদের হাড়ের একটা অদ্ভুত নিয়ম আছে,"
  },
  {
    "id": 18,
    "startMs": 53014,
    "endMs": 55498,
    "startFrame": 3181,
    "endFrame": 3330,
    "text": "যাকে বলে, ইউজ ইট অর লুজ ইট।"
  },
  {
    "id": 19,
    "startMs": 55568,
    "endMs": 57695,
    "startFrame": 3334,
    "endFrame": 3462,
    "text": "আপনি যখন সারাদিন চেয়ারে বসে থাকেন"
  },
  {
    "id": 20,
    "startMs": 57765,
    "endMs": 59546,
    "startFrame": 3466,
    "endFrame": 3573,
    "text": "এবং শরীরে কোনো ভার বা চাপ পড়ে না,"
  },
  {
    "id": 21,
    "startMs": 59616,
    "endMs": 62893,
    "startFrame": 3577,
    "endFrame": 3774,
    "text": "তখন মস্তিষ্ক ভাবে, এই হাড়ের তো কোনো কাজই নেই!"
  },
  {
    "id": 22,
    "startMs": 62963,
    "endMs": 65557,
    "startFrame": 3778,
    "endFrame": 3933,
    "text": "তাই সে রাজমিস্ত্রিদের ছুটি দিয়ে দেয়।"
  },
  {
    "id": 23,
    "startMs": 65627,
    "endMs": 68405,
    "startFrame": 3938,
    "endFrame": 4104,
    "text": "অথচ ওদিকে অতিরিক্ত চিনি, ধূমপান বা হরমোনের ঘাটতিতে"
  },
  {
    "id": 24,
    "startMs": 68475,
    "endMs": 71780,
    "startFrame": 4109,
    "endFrame": 4307,
    "text": "ভাঙচুর দল দ্বিগুণ গতিতে হাড় খুঁড়তে থাকে।"
  },
  {
    "id": 25,
    "startMs": 71850,
    "endMs": 74159,
    "startFrame": 4311,
    "endFrame": 4450,
    "text": "আর ঠিক তখনই হাঁটু বা কোমরে ব্যথা শুরু হলে"
  },
  {
    "id": 26,
    "startMs": 74229,
    "endMs": 76897,
    "startFrame": 4454,
    "endFrame": 4614,
    "text": "আমরা ক্যালসিয়াম খাওয়া শুরু করি।"
  },
  {
    "id": 27,
    "startMs": 76967,
    "endMs": 80530,
    "startFrame": 4618,
    "endFrame": 4832,
    "text": "কিন্তু সমস্যা হলো, হাড়ের গোডাউনের দরজায় একটি তালা ঝুলানো থাকে,"
  },
  {
    "id": 28,
    "startMs": 80600,
    "endMs": 83078,
    "startFrame": 4836,
    "endFrame": 4985,
    "text": "যার একমাত্র চাবি হলো ভিটামিন ডি।"
  },
  {
    "id": 29,
    "startMs": 83148,
    "endMs": 84509,
    "startFrame": 4989,
    "endFrame": 5071,
    "text": "আপনার শরীরে যদি এই চাবি না থাকে,"
  },
  {
    "id": 30,
    "startMs": 84579,
    "endMs": 86755,
    "startFrame": 5075,
    "endFrame": 5205,
    "text": "তবে যত দামি ক্যালসিয়ামই খান না কেন,"
  },
  {
    "id": 31,
    "startMs": 86825,
    "endMs": 89206,
    "startFrame": 5210,
    "endFrame": 5352,
    "text": "তা হাড়ে ঢুকতেই পারবে না।"
  },
  {
    "id": 32,
    "startMs": 89276,
    "endMs": 92553,
    "startFrame": 5357,
    "endFrame": 5553,
    "text": "উল্টো রক্তনালী বা কিডনিতে গিয়ে পাথর হয়ে জমবে!"
  },
  {
    "id": 33,
    "startMs": 92623,
    "endMs": 94171,
    "startFrame": 5557,
    "endFrame": 5650,
    "text": "তাই হাড়ের ক্ষয় উল্টে দিতে"
  },
  {
    "id": 34,
    "startMs": 94241,
    "endMs": 96465,
    "startFrame": 5654,
    "endFrame": 5788,
    "text": "আজ থেকে এই তিনটি কাজ একসাথে করুন।"
  },
  {
    "id": 35,
    "startMs": 96535,
    "endMs": 99032,
    "startFrame": 5792,
    "endFrame": 5942,
    "text": "এক। ঘুমন্ত রাজমিস্ত্রিদের জাগাতে"
  },
  {
    "id": 36,
    "startMs": 99102,
    "endMs": 101781,
    "startFrame": 5946,
    "endFrame": 6107,
    "text": "প্রতিদিন অন্তত বিশ মিনিট দ্রুত হাঁটুন,"
  },
  {
    "id": 37,
    "startMs": 101851,
    "endMs": 103890,
    "startFrame": 6111,
    "endFrame": 6233,
    "text": "সিঁড়ি ভাঙুন বা হালকা ওজন তুলুন।"
  },
  {
    "id": 38,
    "startMs": 103960,
    "endMs": 105273,
    "startFrame": 6238,
    "endFrame": 6316,
    "text": "কারণ হাড়ে চাপ না পড়লে"
  },
  {
    "id": 39,
    "startMs": 105343,
    "endMs": 108507,
    "startFrame": 6321,
    "endFrame": 6510,
    "text": "নতুন হাড় গড়ার ওয়ার্ক অর্ডারই তৈরি হয় না।"
  },
  {
    "id": 40,
    "startMs": 108577,
    "endMs": 110762,
    "startFrame": 6515,
    "endFrame": 6646,
    "text": "দুই। গোডাউনের তালা খুলতে নিয়মিত গায়ে রোদ লাগান,"
  },
  {
    "id": 41,
    "startMs": 110832,
    "endMs": 114572,
    "startFrame": 6650,
    "endFrame": 6874,
    "text": "অথবা ভিটামিন ডি-থ্রি ও কে-টু নিশ্চিত করুন।"
  },
  {
    "id": 42,
    "startMs": 114642,
    "endMs": 116292,
    "startFrame": 6879,
    "endFrame": 6978,
    "text": "আর তিন। কাঁটাসহ ছোট মাছ, টক দই,"
  },
  {
    "id": 43,
    "startMs": 116362,
    "endMs": 118795,
    "startFrame": 6982,
    "endFrame": 7128,
    "text": "তিল ও ডিম থেকে আসল কাঁচামাল নিন।"
  },
  {
    "id": 44,
    "startMs": 118865,
    "endMs": 121915,
    "startFrame": 7132,
    "endFrame": 7315,
    "text": "মনে রাখবেন, হাড়কে শুধু ক্যালসিয়াম দেবেন না।"
  },
  {
    "id": 45,
    "startMs": 121985,
    "endMs": 124578,
    "startFrame": 7319,
    "endFrame": 7475,
    "text": "হাড়কে শক্ত থাকার একটা কারণ দিন!"
  },
  {
    "id": 46,
    "startMs": 124648,
    "endMs": 127481,
    "startFrame": 7479,
    "endFrame": 7649,
    "text": "এমন স্বাস্থ্যবিষয়ক সহজ ভিডিও পেতে"
  },
  {
    "id": 47,
    "startMs": 127551,
    "endMs": 129116,
    "startFrame": 7653,
    "endFrame": 7747,
    "text": "এডুটক পেজটি ফলো করুন।"
  }
]